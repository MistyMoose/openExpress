<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The entitlements of the engine's Python (Contents/Resources/engine/bin/python3.13), signed
     with the hardened runtime by macos/scripts/build-pkg.sh. Why each one is here, and why the
     others are not: docs/macos.md, "Signing and notarization". GPL-3.0-or-later. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
